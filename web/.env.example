# Copy to .env.local, or run `pnpm setup` to generate one.
APP_SECRET=            # 32+ random characters, encrypts SSH keys and env vars
APP_URL=http://localhost:3000
DATABASE_URL=file:./data/nest-deploy.db

DEV_LOGIN=0            # 1 = fake sign-in, local development only

HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

RUN_WORKER=1            # 1 = web app also runs the queue; 0 = use `pnpm worker`
BUILD_RUNNER=docker    # docker | local (local = no isolation, dev only)
BUILD_TIMEOUT_SECONDS=900
DEPLOY_WORK_DIR=./data/work
